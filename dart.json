{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>screensteward/renovate-config"],
  "packageRules": [
    {
      "description": "Group Dart lints and analyzer packages",
      "matchManagers": ["pub"],
      "matchPackageNames": [
        "lints",
        "very_good_analysis",
        "flutter_lints",
        "analyzer",
        "analyzer_plugin"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dart-lints",
      "automerge": true
    },
    {
      "description": "Group Dart code generation tooling",
      "matchManagers": ["pub"],
      "matchPackageNames": [
        "build_runner",
        "build_runner_core",
        "json_serializable",
        "freezed",
        "freezed_annotation"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dart-codegen",
      "automerge": true
    }
  ]
}
